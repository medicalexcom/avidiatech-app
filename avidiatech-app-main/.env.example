# ============================================================
# AvidiaTech — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets.
# ============================================================

# --- Clerk (Auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/trial-setup

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Owner Access (CRITICAL) ---
# Comma-separated list of email addresses that bypass ALL subscription and
# quota checks. These accounts have unrestricted access to the platform.
# Also controls access to /internal/support console (via is_support_agent in DB).
OWNER_EMAILS=medicalex.com@gmail.com,avidiatech.com@gmail.com

# --- AI / OpenAI ---
OPENAI_API_KEY=sk-...
# Optional: override the default assistant model (default: gpt-4o-mini)
# ASSISTANT_MODEL=gpt-4o-mini

# --- Pipeline ---
PIPELINE_INTERNAL_SECRET=your-secret-here
# Optional: allow owner accounts to use a synthetic tenant ID if not in team_members
# ALLOW_SYNTHETIC_TENANT_FOR_CREATORS=1

# --- App ---
NEXT_PUBLIC_APP_VERSION=1.0.0
# Optional: secret for /api/debug/* endpoints (remove debug routes in production)
# DEBUG_SECRET=your-debug-secret
